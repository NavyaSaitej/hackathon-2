{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
        "recommended": true,
        "correctness": {
            "noUnusedVariables": "warn"
        },
        "suspicious": {
            "noConsoleLog": "off"
        }
    }
  },
  "formatter": {
    "enabled": false
  },
  "files": {
    "includes": ["**/frontend/**/*.js", "!**/node_modules", "!**/frontend/sw.js"]
  }
}
