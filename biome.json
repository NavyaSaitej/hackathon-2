{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn"
			},
			"suspicious": {
				"noConsole": "off"
			}
		}
	},
	"formatter": {
		"enabled": false
	},
	"files": {
		"includes": [
			"**/frontend/**/*.js",
			"!**/node_modules",
			"!**/frontend/sw.js"
		]
	}
}
